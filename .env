# .env

# Node.js 运行环境
NODE_ENV = 'development'

# 应用环境
VITE_APP_MODE = 'dev'

# 单页应用的基路径
VITE_APP_ROUTER_BASE = '/'

# 是否启用打包体积分析
VITE_APP_BUNDLE_ANALYZE = 0

# APP key
VITE_APP_ID = 'STARTER'

# 应用编码（/user/menus 按此过滤菜单）
VITE_APP_CODE = 'starter'

# 后端 API 代理目标地址
VITE_API_PROXY_TARGET = 'http://localhost:3001'

# 开发服务端口
VITE_DEV_PORT = 5173
